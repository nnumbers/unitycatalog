server.env=dev
## Identity Provider authorization parameters
# examples:
# authorization=enable
# authorization-url=https://accounts.google.com/o/oauth2/auth
# token-url=https://oauth2.googleapis.com/token
# client-id=111122223333-abab1212cdcd3434.apps.googleusercontent.com
# client-secret=GOCSPX-ababfoobarcdcd-5q
server.authorization=disable
server.authorization-url=
server.token-url=
server.client-id=
server.client-secret=
server.redirect-port=
# D-Days H-Hours M-Minutes S-Seconds (P5D = 5 days,PT5H = 5 hours, PT5M = 5 minutes, PT5S = 5 seconds)
server.cookie-timeout=P5D

# Define the model storage root.  Cloud storage or file based allowed.
# If no root specified, the current working directory of the server is used.

#storage-root.models=s3://my-s3-bucket/root
#storage-root.models=abfs://file_system@account_name.dfs.core.windows.net/root
#storage-root.models=gs://my-gc-bucket/root
storage-root.models=file:/tmp/ucroot

## S3 Storage Config (Multiple configs can be added by incrementing the index)
## Example configurations:
##
## AWS S3:
# s3.bucketPath.0=s3://my-aws-bucket
# s3.region.0=us-east-1
# s3.awsRoleArn.0=arn:aws:iam::123456789012:role/unity-catalog-role
# s3.accessKey.0=
# s3.secretKey.0=
##
## MinIO or other S3-compatible storage:
# s3.bucketPath.1=s3://my-minio-bucket
# s3.region.1=us-east-1
# s3.awsRoleArn.1=
# s3.s3ServiceEndpoint.1=http://minio:9000
# s3.stsEndpoint.1=http://minio:9000
# s3.pathStyleAccess.1=true
# s3.accessKey.1=minioadmin
# s3.secretKey.1=minioadmin
##
## Multiple endpoints (AWS + MinIO):
# s3.bucketPath.2=s3://another-bucket
# s3.region.2=us-west-2
# s3.awsRoleArn.2=
# s3.s3ServiceEndpoint.2=https://custom-s3.example.com
# s3.stsEndpoint.2=https://custom-s3.example.com
# s3.pathStyleAccess.2=true
# s3.accessKey.2=
# s3.secretKey.2=

s3.bucketPath.0=
s3.region.0=
s3.awsRoleArn.0=
# Optional: Custom S3 service endpoint for S3-compatible storage (e.g., MinIO, Ceph, Dell ECS)
s3.s3ServiceEndpoint.0=
# Optional: Custom STS endpoint for credential vending (e.g., MinIO)
s3.stsEndpoint.0=
# Optional: Use path-style access (required for MinIO/Ceph, default: true)
s3.pathStyleAccess.0=
# Optional: Static credentials (If blank, will use DefaultCredentialsProviderChain)
s3.accessKey.0=
s3.secretKey.0=
# Test Only: Static session token (If provided, skips STS AssumeRole)
s3.sessionToken.0=

## ADLS Storage Config (Multiple configs can be added by incrementing the index)
adls.storageAccountName.0=
adls.tenantId.0=
adls.clientId.0=
adls.clientSecret.0=

## GCS Storage Config (Multiple configs can be added by incrementing the index)
gcs.bucketPath.0=
# Optional (If blank, it will use Default Application chain to find credentials)
gcs.jsonKeyFilePath.0=